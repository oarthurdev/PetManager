generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  pets     Pet[]
}

model Pet {
  id       String @id @default(uuid())
  name     String
  type     String
  age      Int
  imageUrl String
  owner    User  @relation(fields: [ownerId], references: [id])
  ownerId  String
}

model Breed {
  id   String @id @default(uuid())
  name String @unique
}
